; Calculates the sum of the whole numbers from 1 to 'limit'.

.include "lib.athe"

.data

item[1] 'A'

vector[5] 0, 1, 2, 3, 4

matrix[2*3] 0,   1,   2,
            'a', 'b', 'c'

.code

limit: 5
expected_result: limit * (limit + 1) / 2

LI R1, 0
LI R2, 1
LI R3, limit

loop:
    ADD R1, R1, R2
    INC R2

    CMP R2, R3
    BLE loop                ; loop while R2 <= limit

CMPI R1, expected_result
BEQ equal                   ; branch if R1 == expected_result
JMP different

equal:
    LI R4, 1
    JMP finish

different:
    LI R4, 0

finish:
    JMP finish
