; Calculates the sum of the whole numbers from 1 to 'limit'

limit: 5
expected_result: limit * (limit + 1) / 2

.data

result[1] -1

.code

LI R1, 0
LI R2, 1
LI R3, limit

loop:
    ADD R1, R1, R2
    INC R2

    CMP R2, R3
    BLE loop                ; loop while R2 <= limit

LDI R5, result
LOAD R1, 0[R5]              ; save result into memory

CMPI R1, expected_result
BEQ equal                   ; branch if R1 == expected_result
JMP different

equal:
    LI R4, 1
    JMP finish

different:
    LI R4, 0

finish:
    JMP finish